---
interface menuNavTypes {
  href: string;
  label: string;
}

const menuNav: menuNavTypes[] = [
  { href: "#servicios", label: "Servicios" },
  { href: "#trabajos", label: "Trabajos" },
  { href: "#precios", label: "Precios" },
  { href: "#conoceme", label: "Conóceme" },
  { href: "#contacto", label: "Contacto" },
];
---

<ul
  class="flex flex-col md:flex-row justify-center md:gap-5 items-center font-playfair px-5 py-7"
>
  {
    menuNav &&
      menuNav.map((menu: menuNavTypes) => (
        <li>
          <a
            class="menu-header hover:bg-dorado hover:text-principal"
            href={menu.href}
          >
            {menu.label}
          </a>
        </li>
      ))
  }
</ul>
