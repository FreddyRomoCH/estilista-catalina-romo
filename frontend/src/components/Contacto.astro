---
import type { SocialTypes } from "../types/social";
import SocialMediaIcon from "@components/shared/SocialMediaIcon.astro";
import ContactForm from "./ContactForm.astro";
import ContactInfo from "./ContactInfo.astro";

const { homePageContacto } = Astro.props;

const contact = homePageContacto.section[0].social;
---

<section id="contacto" class="max-w-7xl m-auto mb-12">
  <h2 class="title-section">Contacto</h2>

  <div
    class="flex flex-col md:flex-row justify-center items-start gap-6 bg-principal rounded-md md:w-1/2 m-auto px-10 pt-5"
  >
    <ContactForm />

    <ContactInfo contact={contact} />
  </div>
</section>
